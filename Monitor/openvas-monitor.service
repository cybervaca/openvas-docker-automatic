[Unit]
Description=OpenVAS Monitoring Service
Documentation=https://github.com/cybervaca/openvas-docker-automatic
After=network.target docker.service

[Service]
Type=oneshot
User=redteam
Group=redteam
WorkingDirectory=/opt/gvm/Monitor
ExecStart=/usr/bin/python3 /opt/gvm/Monitor/monitor.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openvas-monitor

# Variables de entorno
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Reinicio en caso de fallo
Restart=on-failure
RestartSec=10

# Timeout
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

