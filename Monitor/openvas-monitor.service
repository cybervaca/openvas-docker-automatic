[Unit]
Description=OpenVAS Monitoring Service
Documentation=https://github.com/cybervaca/openvas-docker-automatic
After=network.target docker.service

[Service]
Type=oneshot
User=redteam
Group=redteam
WorkingDirectory=/opt/gvm/Monitor
# Usar wrapper script que activa el entorno virtual antes de ejecutar
# Especificar explícitamente bash para asegurar que el script se ejecute correctamente
ExecStart=/bin/bash /opt/gvm/Monitor/monitor-wrapper.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openvas-monitor

# Variables de entorno
Environment="PATH=/opt/gvm/gvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Reinicio en caso de fallo
Restart=on-failure
RestartSec=10

# Timeout
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

