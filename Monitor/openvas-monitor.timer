[Unit]
Description=OpenVAS Monitoring Timer
Documentation=https://github.com/cybervaca/openvas-docker-automatic
Requires=openvas-monitor.service

[Timer]
# Ejecutar cada 5 minutos
OnCalendar=*:0/5
# Ejecutar inmediatamente si se perdió la última ejecución
OnActiveSec=0
# Persistir después de reinicio
Persistent=true
# Precisión de 1 minuto
AccuracySec=1min

[Install]
WantedBy=timers.target








